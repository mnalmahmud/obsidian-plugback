{
	"name": "obsidian-plugback",
	"version": "1.0.1",
	"private": true,
	"description": "Keep your plugins and themes in sync across devices.",
	"license": "MIT",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"typecheck": "tsc -noEmit",
		"lint": "eslint .",
		"test": "node esbuild.config.mjs production && node --no-warnings --test --test-isolation=none \"tests/**/*.test.ts\"",
		"check": "node scripts/check-metadata.mjs && pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test",
		"format": "prettier --write .",
		"format:check": "prettier --check ."
	},
	"devDependencies": {
		"@eslint/js": "^9.39.5",
		"@types/node": "^26.6.5",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.5",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"obsidian": "^1.14.4",
		"prettier": "3.9.10",
		"typescript": "~6.0.3",
		"typescript-eslint": "^8.71.2"
	},
	"engines": {
		"node": ">=26"
	},
	"prettier": {
		"useTabs": true,
		"printWidth": 100
	}
}
